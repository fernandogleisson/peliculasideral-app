# .env.example — copy to .env.local and fill values

# Postgres / Supabase
# DATABASE_URL: pooled connection (transaction mode, used at runtime by drizzle client)
# DATABASE_URL_DIRECT: direct connection (used by drizzle-kit for migrations only)
DATABASE_URL=
DATABASE_URL_DIRECT=

# Playwright (optional, defaults to http://localhost:3000)
BASE_URL=http://localhost:3000
