# .env.example — copy to .env.local and fill values

# ─── Postgres / Supabase ─────────────────────────────────────────────────
# DATABASE_URL: pooled connection (transaction mode, runtime drizzle client)
# DATABASE_URL_DIRECT: direct connection (drizzle-kit migrations only)
DATABASE_URL=
DATABASE_URL_DIRECT=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Astrologer (RapidAPI) ───────────────────────────────────────────────
RAPIDAPI_KEY=
ASTROLOGER_HOST=astrologer.p.rapidapi.com

# ─── Geoapify (city autocomplete) ────────────────────────────────────────
GEOAPIFY_API_KEY=

# ─── Outline (KB) ────────────────────────────────────────────────────────
OUTLINE_API_KEY=
OUTLINE_WEBHOOK_SECRET=
OUTLINE_APP_CONTENT_COLLECTION_ID=

# ─── Paperclip (interpretation generator) ────────────────────────────────
PAPERCLIP_API_BASE=https://paperclip.agenciajubileu.com.br
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_CALLBACK_SECRET=
# 'paperclip' or 'anthropic'
INTERPRETATION_GENERATOR=paperclip

# ─── Anthropic (fallback) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Resend (transactional email) ────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=suporte@peliculasideral.com.br

# ─── Cloudflare (DNS / DKIM via MCP) ─────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ─── Meta WhatsApp Business ──────────────────────────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

# ─── Chatwoot (suporte) ──────────────────────────────────────────────────
CHATWOOT_API_BASE=
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=

# ─── Cookies / Sentry ────────────────────────────────────────────────────
# 32 bytes hex (64 chars)
COOKIE_ENCRYPTION_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Public site config ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://peliculasideral.com.br
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_SUPPORTED_LOCALES=pt-BR,en-US,es-419

# ─── Playwright (optional, defaults to http://localhost:3000) ────────────
BASE_URL=http://localhost:3000
